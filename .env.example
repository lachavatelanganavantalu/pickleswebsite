# Copy to .env.local for local dev (never commit .env.local)

# Required for /admin login
ADMIN_USERNAME=lachava
ADMIN_PASSWORD=change-this-password
SESSION_SECRET=use-a-long-random-string-here

# Razorpay — required for checkout (Dashboard → Settings → API Keys)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Required for production — customer accounts, orders, products (Vercel needs MongoDB Atlas)
MONGODB_URI=mongodb+srv://...

# Customer login sessions (optional; falls back to SESSION_SECRET)
# CUSTOMER_SESSION_SECRET=long-random-string

# DTDC shipment WhatsApp
NEXT_PUBLIC_DTDC_WHATSAPP_NUMBER=919949525111

# Public site URL (canonical, OG, JSON-LD, robots.txt, sitemap)
# Required on Vercel — must match the live custom domain, not a preview *.vercel.app host
NEXT_PUBLIC_SITE_URL=https://www.lachavapickles.store
