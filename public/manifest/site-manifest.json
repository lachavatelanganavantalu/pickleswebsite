  "workflows": [
    {
      "workflow_id": "browse_and_add_to_cart",
      "name": "Browse pickles and add items to cart",
      "intent_hints": ["browse pickles", "add to cart", "shop pickles", "buy pickle", "pickles"],
      "routes": ["home", "product_detail"],
      "steps": [
        {
          "step_id": "open_product",
          "description": "Open a product detail page",
          "actions": [
            {
              "action_id": "click_product_card",
              "kind": "click",
              "label": "Open product card",
              "target_texts": ["Mutton", "Fish", "Chicken", "Pickle", "Tomato", "Usirikaya", "Mamidi"],
              "route_id": "home",
              "element_id": "product_card",
              "wait_after_ms": 250
            }
          ]
        },
        {
          "step_id": "select_size",
          "description": "Choose a variant size",
          "actions": [
            {
              "action_id": "choose_size",
              "kind": "click",
              "label": "Select size",
              "target_texts": ["1/2 kg", "1 kg", "500g", "250g"],
              "element_id": "size_select",
              "route_id": "product_detail",
              "wait_after_ms": 200
            }
          ]
        },
        {
          "step_id": "add_to_cart",
          "description": "Add item to cart",
          "actions": [
            {
              "action_id": "click_add_to_cart",
              "kind": "click",
              "label": "Add to cart",
              "target_texts": ["Add to cart", "ADD TO CART"],
              "element_id": "add_to_cart",
              "route_id": "product_detail",
              "wait_after_ms": 300
            }
          ]
        }
      ]
    },
    {
      "workflow_id": "review_cart_and_checkout",
      "name": "Review cart and go to checkout",
      "intent_hints": ["review cart", "checkout", "proceed to checkout", "cart"],
      "routes": ["cart", "checkout"],
      "steps": [
        {
          "step_id": "open_cart",
          "description": "Open the cart",
          "actions": [
            {
              "action_id": "open_cart_page",
              "kind": "click",
              "label": "Cart icon",
              "target_texts": ["Cart", "CART", "Items"],
              "element_id": "cart_button",
              "route_id": "cart",
              "wait_after_ms": 200
            }
          ]
        },
        {
          "step_id": "proceed_checkout",
          "description": "Proceed to checkout",
          "actions": [
            {
              "action_id": "click_proceed_to_checkout",
              "kind": "click",
              "label": "Proceed to checkout",
              "target_texts": ["Proceed to checkout", "PROCEED TO CHECKOUT"],
              "element_id": "proceed_to_checkout",
              "route_id": "cart",
              "wait_after_ms": 350
            }
          ]
        }
      ]
    },
    {
      "workflow_id": "checkout_and_payment",
      "name": "Checkout and place order",
      "intent_hints": ["fill shipping details", "place order", "checkout"],
      "routes": ["checkout", "order_payment"],
      "steps": [
        {
          "step_id": "place_order",
          "description": "Submit checkout form and place order",
          "actions": [
            {
              "action_id": "click_place_order",
              "kind": "click",
              "label": "Place order button",
              "target_texts": ["Place order", "PLACE ORDER"],
              "element_id": "place_order",
              "route_id": "checkout",
              "wait_after_ms": 500
            }
          ]
        },
        {
          "step_id": "pause_for_payment",
          "description": "Pause for QR/UPI payment and WhatsApp screenshot verification",
          "requires_human": true,
          "actions": [
            {
              "action_id": "confirm_payment_on_whatsapp",
              "kind": "pause",
              "label": "WhatsApp screenshot",
              "element_id": "whatsapp_screenshot",
              "route_id": "order_payment",
              "requires_human": true,
              "human_handoff_message": "Please scan the QR code or copy the Phone number, complete the payment in your UPI app, and send the screenshot via WhatsApp to confirm the order.",
              "wait_after_ms": 0
            }
          ]
        }
      ]
    }
  ],
  "sensitive_keywords": ["payment", "confirm", "screenshot", "qr"],
  "restricted_actions": ["whatsapp_screenshot"],
  "notes": "Assal Heritage Pickles client manifest."
}
